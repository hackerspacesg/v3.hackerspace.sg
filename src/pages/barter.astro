---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';

const barterData = {
  title: 'Barter Membership',
  heading: 'Barter Membership',
  description:
    "Trade your time for 24/7 access to HackerspaceSG. A fair exchange with expectations on both sides.",
  generalFeatures: [
    {
      icon: 'lucide:clock',
      title: '24/7 Access',
      description:
        'Get unlimited access to HackerspaceSG, same as a Co-working membership.',
    },
    {
      icon: 'lucide:users',
      title: 'Community',
      description:
        'Make HSG part of your weekly routine. Build the habit, build the belonging.',
    },
    {
      icon: 'lucide:calendar',
      title: 'Consistent Schedule',
      description:
        'Same days, same times, every week. Routine builds habit. Habit builds belonging.',
    },
    {
      icon: 'lucide:handshake',
      title: 'Fair Exchange',
      description:
        "You're trading time and effort for access — not volunteering. We'll ask you to do specific things.",
    },
  ],
  roles: [
    {
      name: 'Host',
      hours: '16 hours/week',
      timeSlots: 'Any time between 10am to midnight, in 4-hour blocks',
      suitableFor:
        'People who enjoy helping others and making spaces feel welcoming.',
      duties: [
        'Welcome visitors and day pass users',
        'Give quick orientations to new users',
        'Be the friendly point of contact',
        'Help with co-working bookings',
      ],
    },
    {
      name: 'Maker',
      hours: '8 hours/week',
      timeSlots: 'Weekday evenings or weekends, in 4-hour blocks',
      suitableFor:
        'Makers and tinkerers who can help maintain our tools and hardware space.',
      duties: [
        'Keep shared tools organised',
        'Help with hardware room supervision',
        'Guide safe tool usage',
        'Assist with 3D printing',
      ],
    },
  ],
  expectations: [
    {
      icon: 'lucide:calendar-clock',
      title: '2+ Month Commitment',
      description:
        "It takes a while to get familiar with the space. We're flexible about exams and travel.",
    },
    {
      icon: 'lucide:message-circle',
      title: 'Use Telegram',
      description:
        'Stay available on Telegram during shifts and be generally responsive.',
    },
    {
      icon: 'lucide:compass',
      title: 'Be Responsive to Direction',
      description:
        "This is a barter arrangement. We may ask you to do specific things during your shifts — that's part of the deal.",
    },
    {
      icon: 'lucide:check-circle',
      title: 'Be Reliable',
      description:
        'Pick a consistent schedule and stick to it. Show up. Do the walkthrough.',
    },
  ],
};
---

<Layout title={barterData.title} description={barterData.description}>
  <section class="w-full bg-white py-8 dark:bg-gray-800">
    <div class="container mx-auto px-4 md:px-6">
      <h1
        class="mb-4 text-center text-3xl font-bold tracking-tighter text-red-600 dark:text-red-400 sm:text-5xl">
        {barterData.heading}
      </h1>
      <p
        class="mx-auto mb-4 max-w-2xl text-center text-xl text-gray-600 dark:text-gray-300">
        {barterData.description}
      </p>
      <p
        class="mx-auto mb-12 max-w-2xl text-center text-sm text-gray-500 dark:text-gray-400">
        This used to be called "Volunteer Programme." We renamed it because
        "volunteer" implies charity — and this is a structured exchange, not a
        favour.
      </p>

      <div class="mb-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          barterData.generalFeatures.map((feature) => (
            <div class="flex flex-col items-center rounded-lg bg-gray-50 p-6 text-center shadow-md dark:bg-gray-700">
              <Icon
                name={feature.icon}
                class="mb-4 h-12 w-12 text-red-600 dark:text-red-400"
              />
              <h3 class="mb-2 text-xl font-bold text-gray-800 dark:text-gray-200">
                {feature.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>

      <!-- The Real Goal -->
      <div
        class="mx-auto mb-16 max-w-2xl rounded-lg bg-lime-50 p-8 dark:bg-gray-700">
        <h2
          class="mb-4 text-2xl font-bold text-gray-800 dark:text-gray-200">
          The real goal: making HSG part of your week
        </h2>
        <p class="mb-4 text-gray-600 dark:text-gray-300">
          The Barter Members who thrive are the ones who stop thinking "I have a
          shift on Tuesday" and start thinking "Tuesday evening is my HSG
          evening." You come in, do your thing, keep an eye on the space, chat
          with whoever's around. It becomes your third place.
        </p>
        <p class="text-gray-600 dark:text-gray-300">
          The first month is the hardest. After that, it's just where you go on
          Tuesday.
        </p>
      </div>

      <div class="mb-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
        {
          barterData.roles.map((role) => (
            <div class="flex flex-col rounded-lg bg-gray-50 p-6 shadow-md dark:bg-gray-700">
              <h3 class="mb-2 text-2xl font-bold text-red-600 dark:text-red-400">
                {role.name}
              </h3>
              <p class="mb-2 text-xl font-semibold">{role.hours}</p>
              <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
                {role.timeSlots}
              </p>
              <p class="mb-4 text-gray-600 dark:text-gray-300">
                {role.suitableFor}
              </p>
              <div class="mb-6 flex-grow">
                <h4 class="mb-2 font-semibold text-gray-800 dark:text-gray-200">
                  What You'll Do:
                </h4>
                <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
                  {role.duties.map((duty) => (
                    <li class="flex items-center">
                      <Icon
                        name="fa:check"
                        class="mr-2 h-4 w-4 text-green-500"
                      />
                      <span>{duty}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mx-auto max-w-3xl">
        <h2
          class="mb-8 text-center text-2xl font-bold text-red-600 dark:text-red-400">
          What We Expect
        </h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          {
            barterData.expectations.map((expectation) => (
              <div class="flex flex-col items-start rounded-lg bg-gray-50 p-6 shadow-md dark:bg-gray-700">
                <Icon
                  name={expectation.icon}
                  class="mb-4 h-8 w-8 text-red-600 dark:text-red-400"
                />
                <h3 class="mb-2 text-lg font-bold text-gray-800 dark:text-gray-200">
                  {expectation.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-300">
                  {expectation.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- The Pipeline -->
      <div
        class="mx-auto mt-16 max-w-2xl rounded-lg bg-gray-50 p-8 shadow-md dark:bg-gray-700">
        <h2 class="mb-4 text-2xl font-bold text-red-600 dark:text-red-400">
          The barter-to-community pipeline
        </h2>
        <ol
          class="list-decimal space-y-3 pl-5 text-gray-600 dark:text-gray-300">
          <li>
            <strong>Month 1:</strong> You're learning the space, the tools, the people.
            It feels new.
          </li>
          <li>
            <strong>Month 2–3:</strong> You've got your routine. You know the regulars.
            You have your spot.
          </li>
          <li>
            <strong>Month 4+:</strong> You're part of the furniture. People ask you
            questions. You might start thinking about becoming a paying member or
            supporter.
          </li>
        </ol>
      </div>

      <!-- How to Apply -->
      <div
        class="mx-auto mt-8 max-w-2xl rounded-lg bg-gray-50 p-8 shadow-md dark:bg-gray-700">
        <h2 class="mb-6 text-2xl font-bold text-red-600 dark:text-red-400">
          How to Apply
        </h2>
        <ol
          class="list-decimal space-y-4 pl-5 text-gray-600 dark:text-gray-300">
          <li>
            Message <strong>HackerspaceSG Admin</strong> on Telegram
          </li>
          <li>Tell us about yourself and your availability</li>
          <li>Come for a quick in-person chat</li>
          <li>
            If it's a good fit, we'll onboard you and give you access to the
            shared calendar
          </li>
        </ol>
        <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
          * Unlimited access means at most 16 hours a day. You can't live here —
          though we get it if there's an occasional deadline.
        </p>
      </div>
    </div>
  </section>
</Layout>
