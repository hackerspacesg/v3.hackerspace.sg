---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const tiers = [
  {
    name: 'Community Sponsor',
    price: '$1,200/year',
    description:
      'Your name on the sponsor board and 2 supporter passes for your team.',
    features: [
      'Name on sponsor board (physical + digital)',
      '2 supporter passes ($365 value each)',
      'Mentioned in monthly supporter update',
    ],
  },
  {
    name: 'Space Sponsor',
    price: '$3,000/year',
    description:
      'Prominent placement and supporter passes for your team.',
    features: [
      'Prominent placement on sponsor board',
      '5 supporter passes ($365 value each)',
      'Logo on website sponsor page',
      'Mentioned in monthly supporter update',
    ],
  },
  {
    name: 'Rent Sponsor',
    price: '$6,000/year',
    description:
      '"Sponsored by [You]" on the wall for 2 months, plus passes for your whole team.',
    features: [
      '"Sponsored by [You]" on the wall for 2 months',
      '10 supporter passes ($365 value each)',
      'Logo on website sponsor page',
      'Mentioned in monthly supporter update',
      'Named in annual birthday celebration',
    ],
  },
];

const microSponsorships = [
  { label: 'Internet bill', amount: '$101/month' },
  { label: 'Accounting', amount: '$60/month' },
  { label: 'Aircon servicing', amount: '$60/quarter' },
  { label: 'Insurance', amount: '$100/month' },
];
---

<Layout
  title="Sponsor Us"
  description="Support HackerspaceSG as an organisation with a sponsorship.">
  <section class="w-full bg-white py-12 dark:bg-gray-800 md:py-24">
    <div class="container mx-auto px-4 md:px-6">
      <h1
        class="mb-8 text-center text-3xl font-bold tracking-tighter text-red-600 dark:text-red-400 sm:text-5xl">
        Sponsor HackerspaceSG
      </h1>
      <p
        class="mx-auto mb-4 max-w-2xl text-center text-xl text-gray-600 dark:text-gray-300">
        HackerspaceSG is open source infrastructure for Singapore's tech
        community. Like your favourite OSS project, it needs sponsors to
        survive.
      </p>
      <p
        class="mx-auto mb-12 max-w-2xl text-center text-gray-600 dark:text-gray-300">
        All tiers are billed annually — companies prefer lump sums, and we
        prefer predictable revenue.
      </p>

      <div class="mb-16 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <div class="flex flex-col rounded-lg bg-gray-50 p-6 shadow-md dark:bg-gray-700">
              <h3 class="mb-2 text-2xl font-bold text-red-600 dark:text-red-400">
                {tier.name}
              </h3>
              <p class="mb-4 text-3xl font-bold">{tier.price}</p>
              <p class="mb-6 text-gray-600 dark:text-gray-300">
                {tier.description}
              </p>
              <ul class="mb-6 flex-grow space-y-2 text-sm text-gray-600 dark:text-gray-300">
                {tier.features.map((feature) => (
                  <li class="flex items-start">
                    <Icon
                      name="fa:check"
                      class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-green-500"
                    />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a
                href="mailto:contact@hackerspace.sg?subject=Sponsorship%20Enquiry"
                class="mt-auto block w-full rounded bg-red-600 px-4 py-2 text-center font-semibold text-white hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800">
                Get in touch
              </a>
            </div>
          ))
        }
      </div>

      <div class="mx-auto max-w-2xl">
        <h2
          class="mb-6 text-center text-2xl font-bold text-red-600 dark:text-red-400">
          Micro-sponsorships
        </h2>
        <p class="mb-6 text-center text-gray-600 dark:text-gray-300">
          Sponsor a specific bill. Your name goes next to it on the board.
        </p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            microSponsorships.map((item) => (
              <div class="flex items-center justify-between rounded-lg bg-gray-50 p-4 shadow-sm dark:bg-gray-700">
                <span class="text-gray-700 dark:text-gray-300">
                  {item.label}
                </span>
                <span class="font-mono font-semibold">{item.amount}</span>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
          Interested? Email <a
            href="mailto:contact@hackerspace.sg"
            class="text-red-600 underline hover:text-red-700"
            >contact@hackerspace.sg</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
